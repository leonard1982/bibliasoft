\q2 \w el|strong="H5921"\w* \w gran|strong="H1419"\w* monstruo \w que|strong="H5921"\w* \w se|strong="H5921"\w* encuentra \w en|strong="H5921"\w* \w medio|strong="H8432"\w* \w de|strong="H5921"\w* sus \w ríos|strong="H2975"\w*,  
\q1 \w que|strong="H5921"\w* \w ha|strong="H3541"\w* \w dicho|strong="H1696"\w*: “\w Mi|strong="H5921"\w* \w río|strong="H2975"\w* \w es|strong="H3541"\w* \w mío|strong="H5921"\w*”,  
\q2 \w y|strong="H5921"\w* \w lo|strong="H5921"\w* he \w hecho|strong="H6213"\w* \w para|strong="H5921"\w* \w mí|strong="H5921"\w*”.   
\q1
\v 4 \w Pondré|strong="H5414"\w* \w anzuelos|strong="H2397"\w* \w en|strong="H8432"\w* sus mandíbulas,  
\q2 y \w haré|strong="H5414"\w* \w que|strong="H3605"\w* \w los|strong="H3605"\w* \w peces|strong="H1710"\w* \w de|strong="H5414"\w* tus \w ríos|strong="H2975"\w* se peguen \w a|strong="H3068"\w* tus escamas.  
