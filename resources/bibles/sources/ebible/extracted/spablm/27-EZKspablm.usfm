\v 16 \w Pero|strong="H3588"\w* dejaré \w de|strong="H3588"\w* \w ellos|strong="H1992"\w* \w a|strong="H3068"\w* \w unos|strong="H1992"\w* \w pocos|strong="H4557"\w* hombres \w que|strong="H3588"\w* escapen \w de|strong="H3588"\w* \w la|strong="H3588"\w* \w espada|strong="H2719"\w*, del \w hambre|strong="H7458"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w la|strong="H3588"\w* peste, \w para|strong="H4616"\w* \w que|strong="H3588"\w* \w cuenten|strong="H5608"\w* \w todas|strong="H3605"\w* \w sus|strong="H1992"\w* \w abominaciones|strong="H8441"\w* \w entre|strong="H3588"\w* \w las|strong="H1992"\w* \w naciones|strong="H1471"\w* adonde lleguen. \w Y|strong="H3068"\w* \w sabrán|strong="H3045"\w* \w que|strong="H3588"\w* \w yo|strong="H3588"\w* soy Yahvé’”.   
\p
