\v 7 \w Y|strong="H3068"\w* \w yo|strong="H6680"\w* \w hice|strong="H6213"\w* \w así|strong="H3651"\w*, \w como|strong="H5921"\w* \w se|strong="H5921"\w* \w me|strong="H5921"\w* \w ordenó|strong="H6680"\w*. \w Saqué|strong="H3318"\w* \w mis|strong="H5375"\w* \w enseres|strong="H3627"\w* \w de|strong="H5921"\w* \w día|strong="H3119"\w*, \w como|strong="H5921"\w* equipaje \w de|strong="H5921"\w* exilio, \w y|strong="H5921"\w* \w al|strong="H5921"\w* atardecer horadé \w la|strong="H5921"\w* \w pared|strong="H7023"\w* \w con|strong="H5921"\w* \w la|strong="H5921"\w* \w mano|strong="H3027"\w*. \w Salí|strong="H3318"\w* \w en|strong="H5921"\w* \w la|strong="H5921"\w* oscuridad \w y|strong="H5921"\w* \w llevé|strong="H5375"\w* \w el|strong="H5921"\w* equipaje \w sobre|strong="H5921"\w* \w el|strong="H5921"\w* \w hombro|strong="H3802"\w* ante sus \w ojos|strong="H5869"\w*.   
