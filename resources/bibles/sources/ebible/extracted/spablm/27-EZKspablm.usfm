\p
\v 20 La \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w*, diciendo:  
\v 21 “\w Hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, \w pon|strong="H7760"\w* tu \w rostro|strong="H6440"\w* \w hacia|strong="H5921"\w* \w Sidón|strong="H6721"\w*, \w y|strong="H5921"\w* \w profetiza|strong="H5012"\w* \w contra|strong="H5921"\w* \w ella|strong="H5921"\w*,  
\v 22 \w y|strong="H3588"\w* di: ‘\w El|strong="H5921"\w* \w Señor|strong="H3068"\w* Yahvé dice:  
\q1 “He \w aquí|strong="H3541"\w* \w que|strong="H3588"\w* estoy \w contra|strong="H5921"\w* \w ti|strong="H5921"\w*, \w Sidón|strong="H6721"\w*.  
