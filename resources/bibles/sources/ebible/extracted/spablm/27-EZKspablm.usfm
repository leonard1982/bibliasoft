\v 15 \w Y|strong="H3068"\w* vine \w a|strong="H3068"\w* \w los|strong="H1992"\w* \w cautivos|strong="H1473"\w* \w en|strong="H8432"\w* Tel-Abib, \w que|strong="H3117"\w* \w moraban|strong="H3427"\w* junto al \w río|strong="H5104"\w* Quebar, y me senté \w donde|strong="H8033"\w* \w ellos|strong="H1992"\w* \w moraban|strong="H3427"\w*; \w allí|strong="H8033"\w* \w permanecí|strong="H3427"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w atónito|strong="H8074"\w* \w entre|strong="H8432"\w* \w ellos|strong="H1992"\w*.   
\p
\v 16 \w Y|strong="H3068"\w* \w aconteció|strong="H1961"\w* \w que|strong="H1697"\w* al \w cabo|strong="H7097"\w* \w de|strong="H1697"\w* \w los|strong="H1961"\w* \w siete|strong="H7651"\w* \w días|strong="H3117"\w* \w vino|strong="H1961"\w* \w a|strong="H3068"\w* \w mí|strong="H1961"\w* \w palabra|strong="H1697"\w* \w de|strong="H1697"\w* Yahvé, diciendo:  
\v 17 “\w Hijo|strong="H1121"\w* \w de|strong="H4480"\w* \w hombre|strong="H1121"\w*, \w yo|strong="H4480"\w* \w te|strong="H4480"\w* he \w puesto|strong="H5414"\w* \w por|strong="H4480"\w* \w centinela|strong="H6822"\w* \w a|strong="H3068"\w* la \w casa|strong="H1004"\w* \w de|strong="H4480"\w* \w Israel|strong="H3478"\w*; \w oirás|strong="H8085"\w*, \w pues|strong="H4480"\w*, tú la \w palabra|strong="H1697"\w* \w de|strong="H4480"\w* mi \w boca|strong="H6310"\w*, y \w los|strong="H1121"\w* amonestarás \w de|strong="H4480"\w* mi parte.  
\v 18 Cuando yo \w dijere|strong="H1696"\w* al \w impío|strong="H7563"\w*: ‘\w De|strong="H1818"\w* \w cierto|strong="H3808"\w* \w morirás|strong="H4191"\w*’; y tú \w no|strong="H3808"\w* \w le|strong="H1931"\w* \w amonestares|strong="H2094"\w* \w ni|strong="H3808"\w* \w le|strong="H1931"\w* \w hablares|strong="H1696"\w* para \w que|strong="H1931"\w* \w el|strong="H1931"\w* \w impío|strong="H7563"\w* sea apercibido \w de|strong="H1818"\w* \w su|strong="H1931"\w* \w mal|strong="H7563"\w* \w camino|strong="H1870"\w* \w a|strong="H3068"\w* fin \w de|strong="H1818"\w* \w que|strong="H1931"\w* \w viva|strong="H2421"\w*, \w el|strong="H1931"\w* \w impío|strong="H7563"\w* \w morirá|strong="H4191"\w* \w por|strong="H1870"\w* \w su|strong="H1931"\w* \w maldad|strong="H5771"\w*, pero \w su|strong="H1931"\w* \w sangre|strong="H1818"\w* \w demandaré|strong="H1245"\w* \w de|strong="H1818"\w* tu \w mano|strong="H3027"\w*.  
\v 19 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* tú \w amonestares|strong="H2094"\w* al \w impío|strong="H7563"\w*, \w y|strong="H3588"\w* \w él|strong="H1931"\w* \w no|strong="H3808"\w* \w se|strong="H1931"\w* convirtiere \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w impiedad|strong="H7562"\w* \w y|strong="H3588"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w mal|strong="H7563"\w* \w camino|strong="H1870"\w*, \w él|strong="H1931"\w* \w morirá|strong="H4191"\w* \w por|strong="H3588"\w* \w su|strong="H1931"\w* \w iniquidad|strong="H5771"\w*, \w pero|strong="H3588"\w* tú habrás \w librado|strong="H5337"\w* tu \w alma|strong="H5315"\w*.”   
\p
\v 20 “\w Y|strong="H3068"\w* \w cuando|strong="H3588"\w* \w el|strong="H1931"\w* \w justo|strong="H6662"\w* \w se|strong="H1931"\w* \w apartare|strong="H7725"\w* \w de|strong="H3588"\w* \w su|strong="H1931"\w* \w justicia|strong="H6664"\w* \w e|strong="H3068"\w* \w hiciere|strong="H6213"\w* \w iniquidad|strong="H5766"\w*, \w y|strong="H3588"\w* \w pusiere|strong="H5414"\w* \w yo|strong="H3588"\w* \w tropiezo|strong="H4383"\w* \w delante|strong="H6440"\w* \w de|strong="H3588"\w* \w él|strong="H1931"\w*, \w él|strong="H1931"\w* \w morirá|strong="H4191"\w*, \w porque|strong="H3588"\w* \w tú|strong="H6213"\w* \w no|strong="H3808"\w* \w le|strong="H1931"\w* \w amonestaste|strong="H2094"\w*; \w en|strong="H3588"\w* \w su|strong="H1931"\w* \w pecado|strong="H2403"\w* \w morirá|strong="H4191"\w*, \w y|strong="H3588"\w* \w sus|strong="H1931"\w* \w justicias|strong="H6666"\w* \w que|strong="H3588"\w* \w había|strong="H3588"\w* \w hecho|strong="H6213"\w* \w no|strong="H3808"\w* vendrán \w en|strong="H3588"\w* \w memoria|strong="H2142"\w*; \w pero|strong="H3588"\w* \w su|strong="H1931"\w* \w sangre|strong="H1818"\w* \w demandaré|strong="H1245"\w* \w de|strong="H3588"\w* \w tu|strong="H6213"\w* \w mano|strong="H3027"\w*.  
\v 21 \w Pero|strong="H3588"\w* \w si|strong="H3588"\w* al \w justo|strong="H6662"\w* \w amonestares|strong="H2094"\w* \w para|strong="H3588"\w* \w que|strong="H3588"\w* \w no|strong="H3808"\w* \w peque|strong="H2398"\w*, \w y|strong="H3588"\w* \w no|strong="H3808"\w* \w pecare|strong="H2398"\w*, \w de|strong="H3588"\w* \w cierto|strong="H3588"\w* \w vivirá|strong="H2421"\w*, \w porque|strong="H3588"\w* \w fue|strong="H1931"\w* \w amonestado|strong="H2094"\w*; \w y|strong="H3588"\w* tú habrás \w librado|strong="H5337"\w* tu \w alma|strong="H5315"\w*.”   
\p
