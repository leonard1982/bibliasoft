\v 18 “\w Hijo|strong="H1121"\w* \w de|strong="H5921"\w* \w hombre|strong="H1121"\w*, llora \w por|strong="H5921"\w* \w la|strong="H5921"\w* \w multitud|strong="H1995"\w* \w de|strong="H5921"\w* \w Egipto|strong="H4714"\w*, \w y|strong="H5921"\w* hazla descender, \w a|strong="H3068"\w* \w ella|strong="H5921"\w* \w y|strong="H5921"\w* \w a|strong="H3068"\w* \w las|strong="H5921"\w* \w hijas|strong="H1323"\w* \w de|strong="H5921"\w* \w las|strong="H5921"\w* \w naciones|strong="H1471"\w* famosas, \w a|strong="H3068"\w* \w las|strong="H5921"\w* partes bajas \w de|strong="H5921"\w* \w la|strong="H5921"\w* tierra, \w con|strong="H5921"\w* \w los|strong="H1121"\w* \w que|strong="H5921"\w* \w descienden|strong="H3381"\w* \w a|strong="H3068"\w* \w la|strong="H5921"\w* fosa.  
